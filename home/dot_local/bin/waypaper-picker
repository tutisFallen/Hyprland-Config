#!/usr/bin/env bash
set -euo pipefail
# Open Waypaper selector (mpvpaper backend) and exit after selection/window close.
# If waypaper is already open, focus by not spawning duplicates.
if pgrep -x waypaper >/dev/null 2>&1; then
  exit 0
fi
waypaper --backend mpvpaper || true
# safety cleanup in case a helper process lingers
pkill -x waypaper >/dev/null 2>&1 || true
